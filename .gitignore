# ========================================================
# 1. FIREBASE & STREAMLIT SECRETS (CRITICAL - DO NOT REMOVE)
# ========================================================
serviceAccountKey.json
*firebase*adminsdk*.json
.streamlit/secrets.toml
.env

# ========================================================
# 2. YOLO & STREAMLIT RUNTIME ARTIFACTS
# ========================================================
# Ignore local cropped images & temporary uploaded media
saved_crops/
temp_uploaded_video.mp4
temp_op_video.mp4
uploaded_custom_model.pt
*.mp4
*.avi
*.mov

# Ignore legacy local SQLite databases
*.db
*.sqlite3

# Ignore standard auto-downloaded YOLO weights (keep only your custom best.pt)
yolo26*.pt
yolo11*.pt
yolov8*.pt
!best.pt

# ========================================================
# 3. STANDARD PYTHON TEMPLATE (GitHub Default)
# ========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# OS & Editor Junk
.vscode/
.idea/
.DS_Store
Thumbs.db
